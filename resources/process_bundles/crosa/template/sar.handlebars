<div class="cq">
  {{!-- Card-level metadata from the OperatorFabric card envelope. --}}
  <div class="cq-section">
    <div class="cq-section-title">Card metadata</div>
    <dl class="cq-meta-list">
      <div class="cq-meta-item">
        <dt>Process</dt>
        <dd>{{card.process}}</dd>
      </div>
      <div class="cq-meta-item">
        <dt>State</dt>
        <dd>{{card.state}}</dd>
      </div>
      <div class="cq-meta-item">
        <dt>Process version</dt>
        <dd>{{card.processVersion}}</dd>
      </div>
      <div class="cq-meta-item">
        <dt>Process instance</dt>
        <dd class="cq-mono">{{card.processInstanceId}}</dd>
      </div>
      <div class="cq-meta-item">
        <dt>Publisher</dt>
        <dd>{{card.publisher}}</dd>
      </div>
      <div class="cq-meta-item">
        <dt>Severity</dt>
        <dd>{{card.severity}}</dd>
      </div>
      <div class="cq-meta-item">
        <dt>Start date</dt>
        <dd>{{dateFormat card.startDate format="yyyy-MM-dd HH:mm:ss"}}</dd>
      </div>

      <div class="cq-meta-item">
        <dt>End date</dt>
        <dd>{{dateFormat card.endDate format="yyyy-MM-dd HH:mm:ss"}}</dd>
      </div>
    </dl>
  </div>

  {{!-- SAR profile metadata from card.data.FullModel. --}}
  {{#with card.data.FullModel}}
    <div class="cq-section">
      <div class="cq-section-title">SAR metadata</div>
      <dl class="cq-meta-list">
        <div class="cq-meta-item">
          <dt>Identifier</dt>
          <dd class="cq-mono">{{identifier}}</dd>
        </div>
        <div class="cq-meta-item">
          <dt>Description</dt>
          <dd>{{description}}</dd>
        </div>
        <div class="cq-meta-item">
          <dt>Title</dt>
          <dd>{{title}}</dd>
        </div>
        <div class="cq-meta-item">
          <dt>Keyword</dt>
          <dd>{{keyword}}</dd>
        </div>
        <div class="cq-meta-item">
          <dt>Scenario time</dt>
          <dd>{{scenarioTime}}</dd>
        </div>
        <div class="cq-meta-item">
          <dt>Created</dt>
          <dd>{{created}}</dd>
        </div>
        <div class="cq-meta-item">
          <dt>Generated by</dt>
          <dd>{{wasGeneratedBy}}</dd>
        </div>
        <div class="cq-meta-item">
          <dt>Application</dt>
          <dd>{{applicationSoftware}}</dd>
        </div>
        <div class="cq-meta-item">
          <dt>Profile version</dt>
          <dd>{{version}}</dd>
        </div>
        <div class="cq-meta-item">
          <dt>Conforms to</dt>
          <dd>{{conformsTo}}</dd>
        </div>
        <div class="cq-meta-item">
          <dt>Access rights</dt>
          <dd>{{accessRights}}</dd>
        </div>
        <div class="cq-meta-item">
          <dt>Model publisher</dt>
          <dd>{{publisher}}</dd>
        </div>
      </dl>
    </div>
  {{/with}}

  {{!-- Power-flow result table. --}}
  <div class="cq-section">
    <div class="cq-section-title">Power flow results</div>

    {{!-- Summary stats for the currently displayed power-flow result set. --}}
    <dl class="cq-stats">
      <div class="cq-stat-item">
        <dt>Total contingency results</dt>
        <dd>{{card.data.ContingencyPowerFlowResult.length}}</dd>
      </div>
    </dl>

    <div class="cq-table-wrap">
      <table class="cq-table">
        {{!-- Column definitions. --}}
        <thead>
          <tr>
            <th style="width: 180px;">ACDCTerminal</th>
            <th>Equipment</th>
            <th>Substation</th>
            <th>Region</th>

            <th style="width: 150px;">BC value</th>
            <th style="width: 150px;">BC loading</th>
            <th style="width: 150px;">CO value</th>
            <th style="width: 150px;">CO loading</th>

            <th style="width: 140px;">Limit</th>
            <th style="width: 220px;">Contingency</th>
            <th style="width: 110px;">BC violation</th>
            <th style="width: 110px;">CO violation</th>
          </tr>
        </thead>

        {{!-- Contingency rows, enriched with matching base-case values where possible. --}}
        <tbody>
          {{#if card.data.ContingencyPowerFlowResult}}
            {{#each card.data.ContingencyPowerFlowResult}}
              <tr class="{{#if isViolation}}cq-row-violation{{/if}}">
                <td class="cq-mono">{{ACDCTerminal}}</td>
                <td>{{EquipmentName}}</td>
                <td>{{Substation}}</td>
                <td>{{ReportedByRegion}}</td>

                {{!-- Base-case value matched by ACDCTerminal. --}}
                <td class="cq-empty">
                  {{#each ../card.data.BaseCasePowerFlowResult}}
                    {{#if (bool ACDCTerminal '===' ../ACDCTerminal)}}
                      {{#if (bool value '>' 100)}}
                        <span class="cq-pill cq-pill-bad">{{numberFormat value maximumFractionDigits=2}}%</span>
                      {{else}}
                        <span class="cq-pill">{{numberFormat value maximumFractionDigits=2}}%</span>
                      {{/if}}
                    {{/if}}
                  {{/each}}
                </td>

                {{!-- Base-case loading matched by ACDCTerminal. --}}
                <td class="cq-empty">{{#each ../card.data.BaseCasePowerFlowResult}}{{#if (bool ACDCTerminal '===' ../ACDCTerminal)}}<span class="cq-pill">{{numberFormat value maximumFractionDigits=2}}%</span>{{/if}}{{/each}}</td>

                {{!-- Contingency absolute value. --}}
                <td><span class="cq-pill">{{numberFormat valueA maximumFractionDigits=2}}</span></td>

                {{!-- Contingency loading percentage. --}}
                <td>
                  {{#if (bool value '>' 100)}}
                    <span class="cq-pill cq-pill-bad">{{numberFormat value maximumFractionDigits=2}}%</span>
                  {{else}}
                    <span class="cq-pill">{{numberFormat value maximumFractionDigits=2}}%</span>
                  {{/if}}
                </td>

                <td class="cq-mono">{{numberFormat OperationalLimitValue maximumFractionDigits=2}}</td>
                <td class="cq-mono">{{Contingency}}</td>

                {{!-- Base-case violation flag matched by ACDCTerminal. --}}
                <td class="cq-empty">
                  {{#each ../card.data.BaseCasePowerFlowResult}}
                    {{#if (bool ACDCTerminal '===' ../ACDCTerminal)}}
                      {{#if this.isViolation}}
                        <span class="cq-pill cq-pill-bad">true</span>
                      {{else}}
                        <span class="cq-pill">false</span>
                      {{/if}}
                    {{/if}}
                  {{/each}}
                </td>

                {{!-- Contingency violation flag for the current row. --}}
                <td>
                  {{#if isViolation}}
                    <span class="cq-pill cq-pill-bad">true</span>
                  {{else}}
                    <span class="cq-pill">false</span>
                  {{/if}}
                </td>
              </tr>
            {{/each}}
          {{else}}
            <tr>
              <td colspan="8" class="cq-muted">No contingency results</td>
            </tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </div>
</div>
